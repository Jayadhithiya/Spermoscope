# ==============================================================================
# Spermoscope Environment Configuration
# ==============================================================================

# Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Model to use for image validation and semen analysis:
# Options: gemini-1.5-flash (recommended, fast & accurate), gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Backend server port (default: 8080)
PORT=8080
